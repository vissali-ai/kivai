# ==========================
# Ads
# ==========================

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# A publicidade fica desativada por padrão em novos ambientes.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_AUTO_ADS=false

# Formato: ca-pub-0000000000000000. O número deve coincidir com public/ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ==========================
# Formulário de contato (Resend)
# ==========================

# Chave privada criada em https://resend.com/api-keys
RESEND_API_KEY=

# Remetente autorizado em um domínio verificado na Resend
# Exemplo: Kivai <contato@seudominio.com.br>
CONTACT_EMAIL_FROM=

# URL privada do backend FastAPI usado pelas conversões no servidor.
KIVAI_BACKEND_URL=http://127.0.0.1:8000

# Segredo compartilhado entre instâncias do backend para assinar links temporários de download.
# Use uma string longa e aleatória em produção. Se omitido, os tokens expiram ao reiniciar o processo.
KIVAI_DOWNLOAD_TOKEN_SECRET=

# ==========================
# Painel administrativo do blog
# ==========================

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_BLOG_BUCKET=blog-media

ADMIN_EMAIL=admin@kivai.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais

# ==========================
# Agente editorial de notícias
# ==========================

# Use rss para coletar pautas sem API paga. Troque para ai somente se desejar geração automática.
NEWS_AGENT_MODE=rss

# Opcional no modo rss. Chave privada criada em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Equilibra qualidade e custo. Pode ser trocado sem alterar o código.
OPENAI_EDITORIAL_MODEL=gpt-5.6-luna

# Gere um valor aleatório com pelo menos 32 caracteres para proteger a rota do Cron.
NEWS_AGENT_CRON_SECRET=

# Limites por execução.
NEWS_AGENT_MAX_AGE_HOURS=48

# ==========================
# Radar público (piloto)
# ==========================

# Desative rapidamente o piloto sem remover a página.
NEWS_RADAR_ENABLED=true

# Cache compartilhado por categoria: mínimo de 300 e máximo de 1800 segundos.
NEWS_RADAR_CACHE_SECONDS=600

# Máximo de buscas por IP anonimizado em uma janela de 10 minutos.
NEWS_RADAR_REQUEST_LIMIT=12

# Opcional. Use um segredo aleatório para anonimizar o identificador do rate limit.
# Se vazio, o servidor usa um segredo privado já configurado.
NEWS_RADAR_RATE_LIMIT_SALT=
